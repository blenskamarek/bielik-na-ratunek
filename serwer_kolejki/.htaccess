# Bez listowania katalogu; z WWW dostępny jest tylko kolejka.php.
Options -Indexes
<FilesMatch "^(?!kolejka\.php$).+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
