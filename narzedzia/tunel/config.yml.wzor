# Konfiguracja nazwanego tunelu Cloudflare dla bramki LLM.
# Skopiuj do %USERPROFILE%\.cloudflared\config.yml i uzupełnij <...> (instrukcja: docs/ZDALNY_BIELIK.md).
tunnel: <ID-TUNELU>
credentials-file: C:\Users\<UZYTKOWNIK>\.cloudflared\<ID-TUNELU>.json

ingress:
  # publiczny adres -> bramka z kluczem (NIE bezpośrednio Ollama :11434)
  - hostname: <bielik.twoja-domena.pl>
    service: http://127.0.0.1:8080
    originRequest:
      connectTimeout: 30s
  # wszystko inne odrzucamy
  - service: http_status:404
